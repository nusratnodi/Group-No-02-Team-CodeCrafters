# Copy this file to .env and adjust as needed.

# Base URL of the Tripza API used by the browser. Leave empty to call /api on the same origin
# (in development Vite forwards /api to API_PROXY_TARGET; in production the backend serves the app).
# Set it only when the API is hosted elsewhere, e.g. https://tripza-api.example.com
VITE_API_URL=

# Where the Vite dev server forwards /api requests (development only, never sent to the browser).
API_PROXY_TARGET=http://localhost:4000

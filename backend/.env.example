# Copy this file to .env and adjust as needed.
PORT=4000
NODE_ENV=development

# Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# PostgreSQL connection (matches the container in ../docker-compose.yml).
# Tables are created automatically, and an empty database is seeded on first start.
DATABASE_URL=postgres://tripza:tripza@localhost:5432/tripza

# Tests create a temporary schema per test suite in this database (defaults to DATABASE_URL).
# TEST_DATABASE_URL=postgres://tripza:tripza@localhost:5432/tripza

# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGIN=*

# Set to false to work fully offline: weather, routing, geocoding and
# live OpenStreetMap places fall back to built-in estimates.
LIVE_APIS=true
